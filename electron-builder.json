{
  "appId": "com.antonreshetov.poliframe.electron",
  "productName": "Poliframe",
  "directories": {
    "output": "dist"
  },
  "files": [
    "build/renderer/**/*",
    "build/main/**/*",
    "build/shared/**/*",
    "!build/**/*.map"
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "build/icons/icon.icns",
    "hardenedRuntime": true,
    "notarize": true,
    "entitlements": "build/entitlements.mac.plist"
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icons/icon.ico"
  },
  "linux": {
    "target": [
      "AppImage",
      "snap"
    ],
    "icon": "build/icons/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Poliframe",
    "artifactName": "${name}-${version}-${arch}-setup.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "antonreshetov",
    "repo": "poliframe"
  },
  "portable": {
    "artifactName": "${name}-${version}-${arch}-portable.${ext}"
  },
  "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
  "asarUnpack": [
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/exiftool-vendored.*/**/*"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources"
    }
  ]
}
